-- Drag menu using title bar
local dragging, dragStart, startPos = false, nil, nil

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = panel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart
        panel.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Chams and boxes for characters in your own project
local function updatePlayer(p)
    if p == player or not p.Character then return end
    local character = p.Character

    local h = character:FindFirstChild("ITTI_Chams")
    if not h then
        h = Instance.new("Highlight")
        h.Name = "ITTI_Chams"
        h.Adornee = character
        h.Parent = character
    end
    h.Enabled = cfg.Chams
    h.FillColor = getColor()
    h.OutlineColor = getColor()
    h.FillTransparency = 0.5

    local root = character:FindFirstChild("HumanoidRootPart")
    if root then
        local box = root:FindFirstChild("ITTI_Box")
        if not box then
            box = Instance.new("BoxHandleAdornment")
            box.Name = "ITTI_Box"
            box.Adornee = root
            box.Size = Vector3.new(4,6,2)
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Parent = root
        end
        box.Visible = cfg.Boxes
        box.Color3 = getColor()
    end
end

